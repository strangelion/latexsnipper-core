{
  "model_type": "trocr",
  "license": "AGPL-3.0",
  "encoder": {
    "input": { "name": "pixel_values", "shape": [1, 3, 4, 4], "dtype": "float32" },
    "output": { "name": "last_hidden_state", "shape": [1, 1, 2] }
  },
  "decoder": {
    "input_ids": { "name": "input_ids", "dtype": "int64" },
    "encoder_hidden": { "name": "encoder_hidden_states" },
    "output": { "name": "logits", "shape": [1, 1, 4] },
    "max_length": 1,
    "eos_token_id": 2,
    "pad_token_id": 0,
    "vocab_size": 4
  },
  "preprocessing": {
    "resize": { "width": 4, "height": 4, "keep_ratio": true, "pad_value": 0 },
    "normalization": { "mean": [0, 0, 0], "std": [1, 1, 1] },
    "color_format": "RGB"
  },
  "decoding": {
    "type": "greedy",
    "beam_width": 1,
    "top_k": 1,
    "tokenizer_file": "tokenizer.json"
  },
  "pipeline": {
    "model_files": {
      "encoder": "encoder.onnx",
      "decoder": "decoder.onnx",
      "tokenizer": "tokenizer.json"
    }
  }
}
