      "model": {
        "id": "evaluation-contract-oracle-v1",
        "sha256": "6a5ccfefc9f0b7593a4859e1721c9e63146e01f68563500da418a0247e6bb94c"
      },
      "execution": {
        "runtime": "evaluation-contract-oracle-v1",
        "provider": "deterministic-fixture",
        "platform": "portable",
        "preprocessingVersion": "corpus-reference-v1",
        "postprocessingVersion": "none"
      },
      "predictions": [
        {
          "sampleId": "mixed-formula-text-001",
          "prediction": {
            "kind": "document",
            "blocks": [
              {
                "id": "b01",
                "kind": "heading",
                "text": "Abstract"
              },
              {
                "id": "b02",
                "kind": "paragraph",
                "text": "We present a novel approach to solving the heat equation using Fourier analysis."
              },
              {
                "id": "b03",
                "kind": "paragraph",
                "text": "The solution can be expressed as:"
              },
              {
                "id": "b04",
                "kind": "formula",
                "text": "u(x,t)=\\sum_{n=1}^{\\infty}B_n\\sin\\left(\\frac{n\\pi x}{L}\\right)e^{-\\alpha(n\\pi/L)^2t}"
              },
              {
                "id": "b05",
                "kind": "paragraph",
                "text": "where alpha is the thermal diffusivity and L is the length of the domain."
              },
              {
                "id": "b06",
                "kind": "heading",
                "text": "Boundary Conditions"
              },
              {
                "id": "b07",
                "kind": "paragraph",
                "text": "For Dirichlet boundary conditions:"
              },
              {
                "id": "b08",
                "kind": "formula",
                "text": "u(0,t)=u(L,t)=0"
              },
              {
                "id": "b09",
                "kind": "paragraph",
                "text": "The coefficients B_n are determined by the initial condition:"
              },
              {
                "id": "b10",
                "kind": "formula",
                "text": "B_n=\\frac{2}{L}\\int_0^L u(x,0)\\sin\\left(\\frac{n\\pi x}{L}\\right)dx"
              },
              {
                "id": "b11",
                "kind": "heading",
                "text": "Numerical Results"
              },
              {
                "id": "b12",
                "kind": "paragraph",
                "text": "We tested with L=1, alpha=0.01, and initial condition u(x,0)=sin(pi x)."
              },
              {
                "id": "b13",
                "kind": "paragraph",
                "text": "The solution converges to zero as t approaches infinity, as expected."
              }
            ]
          }
        }
      ]
    },
